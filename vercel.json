{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler/ejecutar-corte",
      "schedule": "0 13 * * *"
    }
  ]
}
