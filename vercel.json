{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "data/**",
        "node_modules/pdfkit/js/standard-fonts/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler/ejecutar-corte",
      "schedule": "0 13 * * *"
    }
  ]
}
